PORT=5000
# Supabase → Project Settings → Database → Connection string (URI).
# Use "Transaction pooler" (port 6543), NOT direct (5432). Append ?pgbouncer=true for pooler mode.
# If login worked before and suddenly fails with ENOTFOUND, your Supabase project may be paused — restore it in the dashboard.
# Production (Vercel): set DATABASE_URL in the hosting dashboard; backend auto-uses serverless-safe pool settings.
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
CLIENT_URL=http://localhost:5173
# Comma-separated extra frontend URLs (e.g. https://apnaaapan-clickup.vercel.app)
# ALLOWED_ORIGINS=https://apnaaapan-clickup.vercel.app
# On Vercel: auto-allows *.vercel.app origins. Set to false to require CLIENT_URL only.
# ALLOW_VERCEL_ORIGINS=false
# Public backend URL (used in invite emails). On Vercel: https://your-backend.vercel.app/api
API_URL=http://localhost:5000/api
NODE_ENV=development
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
FIREBASE_PROJECT_ID=your-firebase-project-id
# For Vercel/production: paste full Firebase service account JSON (single line).
# Get from Firebase Console → Project Settings → Service Accounts → Generate New Private Key.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
# Optional: max HTTP requests per 15 minutes per IP for non-auth routes (omit for defaults: production 600, development 8000).
# RATE_LIMIT_MAX=2000
